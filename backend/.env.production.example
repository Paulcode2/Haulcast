# Production environment template for the Django backend.
# Copy to backend/.env on the host (or set as platform env vars) and fill in real values.
# Never commit a filled-in .env file.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-generate-a-long-random-value
DJANGO_DEBUG=false
# Comma-separated, no spaces. Include the API host (and frontend host if same-origin serving is used).
DJANGO_ALLOWED_HOSTS=api.example.com
# Comma-separated origins of the deployed frontend, e.g. https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
# Required for live routing. Backend only. Enable HERE Geocoding & Search and Routing v8 for this key.
HERE_API_KEY=
# Set true when serving behind HTTPS (Render/Railway/Heroku router, or any TLS proxy).
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
# Trust the deployed frontend origin(s) for CSRF (comma-separated, https://...).
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
# HSTS: enable only when the whole site is HTTPS-only. Start with a small value, then raise.
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true
DJANGO_LOG_LEVEL=INFO
